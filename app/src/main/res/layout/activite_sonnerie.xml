<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine_sonnerie"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextClock
        style="@style/GrandChiffre"
        android:layout_width="match_parent"
        android:layout_height="120dp" />

    <TextView
        android:id="@+id/titre_sonnerie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/texte"
        android:textSize="22sp" />

    <Button
        android:id="@+id/arreter"
        style="@style/Bouton"
        android:layout_width="match_parent"
        android:layout_marginTop="48dp"
        android:minHeight="64dp"
        android:text="@string/arreter"
        android:textSize="20sp" />

    <Button
        android:id="@+id/repeter"
        style="@style/Bouton.Secondaire"
        android:layout_width="match_parent"
        android:layout_marginTop="16dp"
        android:minHeight="56dp"
        android:text="@string/repeter" />
</LinearLayout>
