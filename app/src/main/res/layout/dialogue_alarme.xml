<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <Button
            android:id="@+id/heure_dialogue"
            style="@style/Bouton.Secondaire"
            android:layout_width="match_parent"
            android:fontFeatureSettings="tnum"
            android:minHeight="64dp"
            android:textSize="30sp" />

        <!-- Les sept boutons des jours sont ajoutés par EcranReveil. -->
        <LinearLayout
            android:id="@+id/jours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <EditText
            android:id="@+id/nom_alarme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/nom_facultatif"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:minHeight="48dp" />

        <CheckBox
            android:id="@+id/vibreur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/vibreur" />
    </LinearLayout>
</ScrollView>
