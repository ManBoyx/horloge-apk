<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/avertissement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/fond_alerte"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/alerte_texte"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/alarmes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/trait"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/alarmes_vide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/alarmes_vide"
        android:textColor="@color/texte2"
        android:textSize="16sp" />

    <Button
        android:id="@+id/ajouter_alarme"
        style="@style/Bouton"
        android:layout_width="match_parent"
        android:layout_marginTop="12dp"
        android:text="@string/ajouter_reveil" />
</LinearLayout>
