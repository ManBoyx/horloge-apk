<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Horloge" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:statusBarColor">@color/fond</item>
        <item name="android:navigationBarColor">@color/barre_navigation</item>
        <item name="android:windowLightStatusBar">@bool/barres_claires</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/texte</item>
        <item name="android:textColorSecondary">@color/texte2</item>
        <!-- Pas d'animation d'ouverture ni de fermeture des écrans. -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.Horloge" parent="Base.Theme.Horloge" />

    <style name="Bouton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/fond_bouton</item>
        <item name="android:textColor">@color/sur_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Bouton.Secondaire">
        <item name="android:background">@drawable/fond_bouton_secondaire</item>
        <item name="android:textColor">@color/texte</item>
    </style>

    <style name="Onglet">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/onglet</item>
        <item name="android:drawableTint">@color/onglet</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Titre">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texte2</item>
    </style>

    <style name="GrandChiffre">
        <item name="android:textColor">@color/texte</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">24sp</item>
        <item name="android:autoSizeMaxTextSize">76sp</item>
    </style>
</resources>
